{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiflow.local/schemas/approval.schema.json",
  "title": "AI Flow approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "decision_unit_id",
    "approval_type",
    "actor",
    "reason",
    "spec_sha256",
    "policy_sha256",
    "subject_commit",
    "approved_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"},
    "decision_unit_id": {"type": "string", "pattern": "^DU-[0-9]{3,}$"},
    "approval_type": {"enum": ["spec", "code", "action"]},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approved_at": {"type": "string", "format": "date-time"}
  }
}
