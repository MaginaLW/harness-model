{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiflow.local/schemas/verifier-context.schema.json",
  "title": "AI Flow verifier context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "decision_unit_ids", "repository_id", "branch", "base_commit", "subject_commit", "spec_sha256", "policy_sha256", "classification_input_sha256", "context_sha256", "content"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"},
    "decision_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^DU-[0-9]{3,}$"}},
    "repository_id": {"type": "string", "format": "uuid"},
    "branch": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content": {"$ref": "#/$defs/content"}
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "frozen_spec", "code_map", "diff_summary", "acceptance_conditions", "known_limitations", "reproduce_command"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "frozen_spec": {"type": "string", "minLength": 1},
        "code_map": {"type": "object", "additionalProperties": false, "required": ["allowed_scope", "changed_paths"], "properties": {"allowed_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        "diff_summary": {"type": "object", "additionalProperties": false, "required": ["files", "additions", "deletions", "binary_files"], "properties": {"files": {"type": "integer", "minimum": 0}, "additions": {"type": "integer", "minimum": 0}, "deletions": {"type": "integer", "minimum": 0}, "binary_files": {"type": "integer", "minimum": 0}}},
        "acceptance_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "known_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reproduce_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
