{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiflow.local/schemas/mutation-manifest.schema.json",
  "title": "AI Flow phase 02 critical mutation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "scope", "mutations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"const": "phase-02-critical"},
    "scope": {"const": "phase-02-critical-safeguards"},
    "mutations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/mutation"}
    }
  },
  "$defs": {
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_id", "safeguard_id", "target", "target_symbol", "operator",
        "expected_detector", "expected_outcome"
      ],
      "properties": {
        "mutation_id": {"type": "string", "pattern": "^MUT-V2-[0-9]{3}$"},
        "safeguard_id": {"type": "string", "pattern": "^V2_[A-Z0-9_]+$"},
        "target": {"type": "string", "pattern": "^.+\\.py$"},
        "target_symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "operator": {
          "enum": [
            "drop_targeted_mutation_required_check",
            "allow_same_verifier_actor",
            "allow_nonpassing_required_check",
            "accept_non_killed_mutation",
            "ignore_snapshot_mismatch"
          ]
        },
        "expected_detector": {
          "type": "string",
          "pattern": "^tests/(?:[A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.py::test_[A-Za-z0-9_]*$"
        },
        "expected_outcome": {"const": "killed"}
      }
    }
  }
}
