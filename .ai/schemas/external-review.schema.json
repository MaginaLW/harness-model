{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiflow.local/schemas/external-review.schema.json",
  "title": "AI Flow external review report envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "target_context",
    "source_subject",
    "source",
    "completion",
    "findings"
  ],
  "properties": {
    "kind": {"const": "external-review"},
    "schema_version": {"const": "1.0"},
    "target_context": {"$ref": "#/$defs/target_context"},
    "source_subject": {"$ref": "#/$defs/source_subject"},
    "source": {"$ref": "#/$defs/source"},
    "completion": {"$ref": "#/$defs/completion"},
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4,}$", "maxLength": 128},
    "review_id": {"type": "string", "pattern": "^REV-[0-9]{4,}$", "maxLength": 128},
    "finding_id": {"type": "string", "pattern": "^RF-[0-9]{3,}$", "maxLength": 128},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_id": {"type": "string", "format": "uuid", "maxLength": 128},
    "review_stage": {"enum": ["design", "implementation"]},
    "source_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "review_stage", "base_commit", "confirmation"],
      "properties": {
        "repository": {"$ref": "#/$defs/source_repository"},
        "review_stage": {"$ref": "#/$defs/review_stage"},
        "base_commit": {"$ref": "#/$defs/commit"},
        "subject_commit": {"$ref": "#/$defs/commit"},
        "confirmation": {"$ref": "#/$defs/confirmation"}
      },
      "allOf": [
        {
          "if": {"properties": {"review_stage": {"const": "design"}}, "required": ["review_stage"]},
          "then": {"not": {"required": ["subject_commit"]}}
        },
        {
          "if": {"properties": {"review_stage": {"const": "implementation"}}, "required": ["review_stage"]},
          "then": {"required": ["subject_commit"]}
        }
      ]
    },
    "target_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "repository_id", "review_stage", "base_commit", "context_sha256"],
      "properties": {
        "task_id": {"$ref": "#/$defs/task_id"},
        "repository_id": {"$ref": "#/$defs/repository_id"},
        "review_stage": {"$ref": "#/$defs/review_stage"},
        "base_commit": {"$ref": "#/$defs/commit"},
        "subject_commit": {"$ref": "#/$defs/commit"},
        "context_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"review_stage": {"const": "design"}}, "required": ["review_stage"]},
          "then": {"not": {"required": ["subject_commit"]}}
        },
        {
          "if": {"properties": {"review_stage": {"const": "implementation"}}, "required": ["review_stage"]},
          "then": {"required": ["subject_commit"]}
        }
      ]
    },
    "source_repository": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository_id"],
          "properties": {
            "kind": {"const": "aiflow_repository_id"},
            "repository_id": {"$ref": "#/$defs/repository_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator", "mapping_record_id"],
          "properties": {
            "kind": {"const": "repository_locator"},
            "locator": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9._~/%-]+$"
            },
            "mapping_record_id": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        }
      ]
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_by_label", "checked_at", "method", "fact_refs"],
      "properties": {
        "checked_by_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "checked_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "method": {"const": "manual_report_git_check"},
        "fact_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "report_version", "raw_sha256", "acquisition_method", "location"],
      "properties": {
        "product": {"const": "ZCode"},
        "report_version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "acquisition_method": {"enum": ["exported", "provided"]},
        "location": {"$ref": "#/$defs/source_location"}
      }
    },
    "source_location": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "https_url"},
            "value": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9._~/%-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "private_archive_id"},
            "value": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        }
      ]
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_scope", "unreviewed_scope"],
      "properties": {
        "status": {"enum": ["completed", "incomplete", "tool_unavailable", "timeout"]},
        "reviewed_scope": {"$ref": "#/$defs/scope_items"},
        "unreviewed_scope": {"$ref": "#/$defs/scope_items"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 8192}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
          "then": {"not": {"required": ["reason"]}},
          "else": {"required": ["reason"]}
        }
      ]
    },
    "scope_items": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_finding_id", "title", "location", "source_priority", "evidence_refs", "mapping"
      ],
      "properties": {
        "source_finding_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "location": {"$ref": "#/$defs/finding_location"},
        "source_priority": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "mapping": {"$ref": "#/$defs/finding_mapping"},
        "description": {"type": "string", "minLength": 1, "maxLength": 8192},
        "source_disposition": {"type": "string", "minLength": 1, "maxLength": 8192},
        "source_verification": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    },
    "finding_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "finding_mapping": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "pending"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "task_id", "review_id", "revision", "finding_id"],
          "properties": {
            "status": {"const": "suggested"},
            "task_id": {"$ref": "#/$defs/task_id"},
            "review_id": {"$ref": "#/$defs/review_id"},
            "revision": {"type": "integer", "minimum": 1},
            "finding_id": {"$ref": "#/$defs/finding_id"}
          }
        }
      ]
    }
  }
}
