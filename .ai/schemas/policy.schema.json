{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiflow.local/schemas/policy.schema.json",
  "title": "AI Flow Policy document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "policy_kind"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_version": {"type": "string", "minLength": 1},
    "policy_kind": {
      "enum": ["hard_rules", "routing", "verification_levels", "permissions"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"const": "agent-bridge-node"},
        "revision": {"type": "integer", "enum": [1, 2]}
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/routing_rule"},
          {"$ref": "#/$defs/permission_rule"}
        ]
      }
    },
    "default_route": {"$ref": "#/$defs/default_route"},
    "allowed_placeholders": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "{python}",
          "{repository_root}",
          "{base_commit}",
          "{subject_commit}",
          "{task_id}",
          "{run_dir}"
        ]
      }
    },
    "allowed_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["{python}", "diff-cover"]}
    },
    "allowed_environment": {
      "type": "array",
      "uniqueItems": true,
      "items": {"const": "COVERAGE_FILE"}
    },
    "run_directories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_root", "ci_root_source", "require_descendant"],
      "properties": {
        "local_root": {"type": "string", "minLength": 1},
        "ci_root_source": {"const": "runner_temp"},
        "require_descendant": {"const": true}
      }
    },
    "levels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3
    },
    "forbidden_automatic_actions": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": ["push", "merge", "deploy", "delete", "secret_export", "paid_external_call"]
      }
    },
    "allowed_automatic_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"const": "read"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"policy_version": {"pattern": "^3(?:\\.|$)"}}},
      "then": {"properties": {"policy_version": {"enum": ["3.1.0", "3.2.0"]}}}
    },
    {
      "if": {
        "properties": {
          "policy_version": {"enum": ["3.1.0", "3.2.0"]},
          "policy_kind": {"const": "verification_levels"}
        },
        "required": ["policy_version", "policy_kind"]
      },
      "then": {
        "required": ["profile"],
        "allOf": [{
          "if": {"properties": {"policy_version": {"const": "3.2.0"}}},
          "then": {"properties": {
            "profile": {"properties": {"revision": {"const": 2}}},
            "levels": {"$ref": "#/$defs/node_v2_levels"}
          }},
          "else": {"properties": {
            "profile": {"properties": {"revision": {"const": 1}}},
            "levels": {"$ref": "#/$defs/node_levels"}
          }}
        }],
        "not": {
          "anyOf": [
            {"required": ["allowed_placeholders"]},
            {"required": ["allowed_commands"]},
            {"required": ["allowed_environment"]},
            {"required": ["run_directories"]}
          ]
        }
      },
      "else": {
        "not": {"required": ["profile"]},
        "properties": {"levels": {"items": {"$ref": "#/$defs/verification_level"}}}
      }
    }
  ],
  "oneOf": [
    {
      "properties": {
        "policy_kind": {"const": "hard_rules"},
        "rules": {
          "items": {"$ref": "#/$defs/routing_rule"}
        }
      },
      "required": ["rules"],
      "not": {
        "anyOf": [
          {"required": ["default_route"]},
          {"required": ["levels"]},
          {"required": ["forbidden_automatic_actions"]},
          {"required": ["allowed_automatic_actions"]}
        ]
      }
    },
    {
      "properties": {
        "policy_kind": {"const": "routing"},
        "rules": {
          "items": {"$ref": "#/$defs/routing_rule"}
        }
      },
      "required": ["rules", "default_route"],
      "not": {
        "anyOf": [
          {"required": ["levels"]},
          {"required": ["forbidden_automatic_actions"]},
          {"required": ["allowed_automatic_actions"]}
        ]
      }
    },
    {
      "properties": {"policy_kind": {"const": "verification_levels"}},
      "required": ["levels"],
      "if": {"properties": {"policy_version": {"enum": ["3.1.0", "3.2.0"]}}},
      "else": {
        "required": [
          "allowed_placeholders", "allowed_commands", "allowed_environment", "run_directories"
        ]
      },
      "not": {
        "anyOf": [
          {"required": ["rules"]},
          {"required": ["default_route"]},
          {"required": ["forbidden_automatic_actions"]},
          {"required": ["allowed_automatic_actions"]}
        ]
      }
    },
    {
      "properties": {
        "policy_kind": {"const": "permissions"},
        "rules": {
          "items": {"$ref": "#/$defs/permission_rule"}
        }
      },
      "required": ["rules", "forbidden_automatic_actions"],
      "not": {
        "anyOf": [
          {"required": ["default_route"]},
          {"required": ["levels"]},
          {"required": ["allowed_placeholders"]}
        ]
      }
    }
  ],
  "$defs": {
    "node_v2_extra_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "timeout_seconds"
      ],
      "properties": {
        "id": {
          "enum": [
            "acceptance",
            "integration",
            "targeted_mutation",
            "independent_verifier"
          ]
        },
        "required": {
          "const": true
        },
        "timeout_seconds": {
          "const": 30
        }
      }
    },
    "node_v2_levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "const": {
            "id": "V0",
            "checks": [
              {
                "id": "contract",
                "required": true,
                "timeout_seconds": 30
              },
              {
                "id": "scope",
                "required": true,
                "timeout_seconds": 30
              },
              {
                "id": "smoke",
                "required": true,
                "timeout_seconds": 30
              },
              {
                "id": "node_build",
                "required": true,
                "timeout_seconds": 300
              },
              {
                "id": "node_check",
                "required": true,
                "timeout_seconds": 600
              },
              {
                "id": "diff_whitespace",
                "required": true,
                "timeout_seconds": 30
              }
            ]
          }
        },
        {
          "const": {
            "id": "V1",
            "checks": [
              {
                "id": "contract",
                "required": true,
                "timeout_seconds": 30
              },
              {
                "id": "scope",
                "required": true,
                "timeout_seconds": 30
              },
              {
                "id": "smoke",
                "required": true,
                "timeout_seconds": 30
              },
              {
                "id": "node_build",
                "required": true,
                "timeout_seconds": 300
              },
              {
                "id": "node_check",
                "required": true,
                "timeout_seconds": 600
              },
              {
                "id": "diff_whitespace",
                "required": true,
                "timeout_seconds": 30
              },
              {
                "id": "ts_coverage",
                "required": true,
                "timeout_seconds": 600
              },
              {
                "id": "ts_total_lines",
                "required": true,
                "timeout_seconds": 30,
                "threshold": 85
              },
              {
                "id": "ts_diff_lines",
                "required": true,
                "timeout_seconds": 30,
                "threshold": 90
              }
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "checks"
          ],
          "properties": {
            "id": {
              "const": "V2"
            },
            "checks": {
              "type": "array",
              "minItems": 9,
              "uniqueItems": true,
              "prefixItems": [
                {
                  "const": {
                    "id": "contract",
                    "required": true,
                    "timeout_seconds": 30
                  }
                },
                {
                  "const": {
                    "id": "scope",
                    "required": true,
                    "timeout_seconds": 30
                  }
                },
                {
                  "const": {
                    "id": "smoke",
                    "required": true,
                    "timeout_seconds": 30
                  }
                },
                {
                  "const": {
                    "id": "node_build",
                    "required": true,
                    "timeout_seconds": 300
                  }
                },
                {
                  "const": {
                    "id": "node_check",
                    "required": true,
                    "timeout_seconds": 600
                  }
                },
                {
                  "const": {
                    "id": "diff_whitespace",
                    "required": true,
                    "timeout_seconds": 30
                  }
                },
                {
                  "const": {
                    "id": "ts_coverage",
                    "required": true,
                    "timeout_seconds": 600
                  }
                },
                {
                  "const": {
                    "id": "ts_total_lines",
                    "required": true,
                    "timeout_seconds": 30,
                    "threshold": 85
                  }
                },
                {
                  "const": {
                    "id": "ts_diff_lines",
                    "required": true,
                    "timeout_seconds": 30,
                    "threshold": 90
                  }
                }
              ],
              "items": {
                "$ref": "#/$defs/node_v2_extra_check"
              }
            }
          }
        }
      ]
    },
    "node_levels": {
      "const": [
        {
          "id": "V0",
          "checks": [
            {"id": "contract", "required": true, "timeout_seconds": 30},
            {"id": "scope", "required": true, "timeout_seconds": 30},
            {"id": "smoke", "required": true, "timeout_seconds": 30},
            {"id": "node_build", "required": true, "timeout_seconds": 300},
            {"id": "node_check", "required": true, "timeout_seconds": 600},
            {"id": "diff_whitespace", "required": true, "timeout_seconds": 30}
          ]
        },
        {
          "id": "V1",
          "checks": [
            {"id": "contract", "required": true, "timeout_seconds": 30},
            {"id": "scope", "required": true, "timeout_seconds": 30},
            {"id": "smoke", "required": true, "timeout_seconds": 30},
            {"id": "node_build", "required": true, "timeout_seconds": 300},
            {"id": "node_check", "required": true, "timeout_seconds": 600},
            {"id": "diff_whitespace", "required": true, "timeout_seconds": 30},
            {"id": "ts_coverage", "required": true, "timeout_seconds": 600},
            {"id": "ts_total_lines", "required": true, "timeout_seconds": 30, "threshold": 85},
            {"id": "ts_diff_lines", "required": true, "timeout_seconds": 30, "threshold": 90}
          ]
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "missing"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "in",
            "contains_any",
            "contains_all",
            "exists",
            "is_empty",
            "greater_than_or_equal",
            "overlaps_paths"
          ]
        },
        "value": {},
        "missing": {"enum": ["no_match", "match", "error"]}
      },
      "if": {"properties": {"operator": {"const": "overlaps_paths"}}},
      "then": {
        "required": ["value"],
        "properties": {
          "value": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "routing_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "route", "explanation", "match", "conditions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
        "priority": {"type": "integer"},
        "route": {"enum": ["AUTO", "ASK", "REVIEW", "BLOCK"]},
        "explanation": {"type": "string", "minLength": 1},
        "match": {"enum": ["all", "any"]},
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/condition"}
        },
        "recovery_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "default_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "route", "explanation"],
      "properties": {
        "id": {"const": "ROUTE-DEFAULT-REVIEW"},
        "priority": {"type": "integer"},
        "route": {"const": "REVIEW"},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "permission_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "action", "effect", "required_approval"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
        "priority": {"type": "integer"},
        "action": {
          "enum": ["push", "merge", "deploy", "delete", "secret_export", "paid_external_call"]
        },
        "effect": {"const": "deny_automatic"},
        "required_approval": {"enum": ["action", "standing_or_action"]}
      },
      "allOf": [
        {
          "if": {"properties": {"required_approval": {"const": "standing_or_action"}}},
          "then": {"properties": {"action": {"enum": ["push", "merge"]}}}
        }
      ]
    },
    "verification_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "timeout_seconds", "required", "result_parser"],
      "properties": {
        "id": {
          "enum": [
            "contract",
            "scope",
            "ruff_check",
            "ruff_format_check",
            "smoke",
            "unit_tests",
            "regression_tests",
            "mypy",
            "coverage_xml",
            "diff_coverage",
            "acceptance",
            "integration",
            "targeted_mutation",
            "independent_verifier"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "required": {"type": "boolean"},
        "result_parser": {"enum": ["exit_zero", "pytest", "coverage_xml", "diff_cover"]},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "COVERAGE_FILE": {"type": "string", "minLength": 1}
          }
        },
        "threshold": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "enum": ["unit_tests", "regression_tests", "coverage_xml", "acceptance", "integration"]
              }
            }
          },
          "then": {"properties": {"timeout_seconds": {"maximum": 4200}}},
          "else": {"properties": {"timeout_seconds": {"maximum": 3600}}}
        }
      ]
    },
    "verification_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checks"],
      "properties": {
        "id": {"enum": ["V0", "V1", "V2"]},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/verification_check"}
        }
      }
    }
  }
}
