{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiflow.local/schemas/evidence.schema.json",
  "title": "AI Flow evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "decision_unit_ids",
    "repository_id",
    "branch",
    "base_commit",
    "subject_commit",
    "spec_sha256",
    "policy_sha256",
    "verification_level",
    "mode",
    "checks",
    "unverified_scenarios",
    "conclusion",
    "generated_at",
    "reproduce_command"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"},
    "decision_unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DU-[0-9]{3,}$"}
    },
    "repository_id": {"type": "string", "format": "uuid"},
    "branch": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "attestation_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_level": {"enum": ["V0", "V1"]},
    "mode": {"enum": ["local", "ci"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "command", "tool_version", "result", "log_ref"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "tool_version": {"type": "string", "minLength": 1},
          "result": {"enum": ["passed", "failed"]},
          "log_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "unverified_scenarios": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "conclusion": {"enum": ["passed", "failed"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "reproduce_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
