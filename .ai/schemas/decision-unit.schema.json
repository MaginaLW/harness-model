{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiflow.local/schemas/decision-unit.schema.json",
  "title": "AI Flow decision unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "decision_unit_id",
    "goal",
    "inputs",
    "planned_actions",
    "impact_scope",
    "reversibility",
    "verification_methods",
    "external_side_effects",
    "permission_requirements"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"},
    "decision_unit_id": {"type": "string", "pattern": "^DU-[0-9]{3,}$"},
    "goal": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "planned_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "impact_scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reversibility": {
      "enum": ["reversible", "conditionally_reversible", "irreversible"]
    },
    "verification_methods": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "external_side_effects": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "permission_requirements": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clear"],
      "properties": {
        "clear": {"type": "boolean"}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]}
      }
    },
    "protections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_backup", "dry_run"],
      "properties": {
        "verified_backup": {"type": "boolean"},
        "dry_run": {"type": "boolean"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "tools_missing"],
      "properties": {
        "automatic": {"type": "boolean"},
        "tools_missing": {"type": "boolean"}
      }
    },
    "impact_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "documentation",
          "ci",
          "cd",
          "secrets",
          "authentication",
          "production_data",
          "external_action"
        ]
      }
    },
    "business_direction_count": {
      "type": "integer",
      "minimum": 1
    },
    "change_characteristics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanical",
        "behavior_changed",
        "code_modified",
        "interaction_scope",
        "regression_risk",
        "error_detectability"
      ],
      "properties": {
        "mechanical": {"type": "boolean"},
        "behavior_changed": {"type": "boolean"},
        "code_modified": {"type": "boolean"},
        "interaction_scope": {"enum": ["local", "cross_file", "cross_module"]},
        "regression_risk": {"type": "boolean"},
        "error_detectability": {"enum": ["high", "low"]}
      }
    }
  }
}
