    "decision_units": [
      {
        "decision_unit_id": "DU-001",
        "goal": "完成 Chapter 12.2：建立消费 12.1 immutable observation 的共享确定性 decision/persistence 核心，将每项事实映射为 record、单调 escalate 或 refuse，持久化 task-local 非状态观察/拒绝事件并仅通过现有 escalate_task 执行升级；禁止 route/V 自动降级，拒绝陈旧绑定和未知输入，不实现 Hook、CLI、CI adapter，不修改 Policy、Gate 或 evidence 行为。",
        "impact_scope": [
          ".ai/schemas/observation-decision.schema.json",
          ".ai/templates/observation-decision.json",
          "src/aiflow/contracts.py",
          "src/aiflow/observation_decision.py",
          "src/aiflow/observation_service.py",
          "src/aiflow/state.py",
          "tests/fixtures/contracts/valid/observation-decision.json",
          "tests/fixtures/contracts/invalid/observation-decision.extra.json",
          "tests/fixtures/contracts/invalid/observation-decision.invalid.json",
          "tests/fixtures/contracts/invalid/observation-decision.missing.json",
          "tests/unit/test_contracts.py",
          "tests/unit/test_observation_decision.py",
          "tests/unit/test_observation_service.py",
          "tests/unit/test_state.py",
          "tests/integration/test_observation_escalation.py",
          "docs/implementation/chapter-12-runtime-observations-hooks.md",
          "docs/superpowers/state/chapters/chapter-12.yaml",
          "docs/superpowers/state/overall.yaml"
        ],
        "planned_actions": [
          "Define one closed version 1.0 observation-decision contract for record, escalate and refuse dispositions with stable reason codes, optional REVIEW/BLOCK targets and closed recovery conditions",
          "Implement a pure deterministic mapper from the five immutable observation kinds plus current route and verification facts, with no repository reads, mutation or route/verification downgrade",
          "Add a bounded service that validates task, base, subject and active Policy bindings before consuming a decision",
          "Persist record and refusal as task-local non-state audit events, and delegate every state-changing escalation exclusively to the existing monotonic escalate_task path",
          "Register only observation_recorded and observation_refused as closed non-state event names without adding or changing any task-state transition",
          "Fail closed on unknown decisions, stale bindings, unsupported state, lower targets, missing recovery facts and unsafe payloads without echoing sensitive values",
          "Add contract, unit and integration replay tests across all five kinds, four sources and AUTO/ASK/REVIEW/BLOCK monotonicity",
          "Project only Chapter 12.2 progress after implementation, verification and required review facts are current; leave Hooks, CLI/CI parity and Chapter exits pending"
        ]
      }
    ],
