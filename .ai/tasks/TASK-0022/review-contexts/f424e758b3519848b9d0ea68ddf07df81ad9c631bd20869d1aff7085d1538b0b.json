    "decision_units": [
      {
        "decision_unit_id": "DU-001",
        "goal": "完成 Chapter 12.5：新增受限 aiflow observe CLI/CI adapter，复用同一 observation parser、deterministic decision 与 task binding core，证明受支持的 pre-commit/pre-command Hook、CLI apply/dry-run 和 detached CI dry-run 对相同事实给出相同非授权结论；CI 与 dry-run 不写 task ledger，并如实记录 shell/平台覆盖边界。",
        "impact_scope": [
          "src/aiflow/observation_service.py",
          "src/aiflow/observation_adapter.py",
          "src/aiflow/cli.py",
          "tests/unit/test_observation_service.py",
          "tests/unit/test_observation_adapter.py",
          "tests/integration/test_observation_parity.py",
          "docs/implementation/chapter-12-runtime-observations-hooks.md",
          "docs/superpowers/state/chapters/chapter-12.yaml",
          "docs/superpowers/state/overall.yaml"
        ],
        "planned_actions": [
          "Refactor the existing current-facts binding check into one public read-only observation evaluation seam without changing the deterministic decision table",
          "Add a bounded observation adapter with explicit apply, dry-run and CI modes, strict mode/source/actor validation and canonical JSON output",
          "Keep apply task-local and idempotent through the existing service while making dry-run and CI strictly non-persistent",
          "Prove semantic parity for every observation kind, route and verification level, plus end-to-end parity for the two actually supported Hook facts",
          "Cover malformed input, ambiguity, stale bindings, path escape, unknown fields, ledger-write prevention and stable exit behavior",
          "Record the supported shell, Hook-install and operating-system boundaries without claiming a generic sandbox",
          "Project only Chapter 12.5 after implementation, formal verification and required review facts are current"
        ]
      }
    ],
