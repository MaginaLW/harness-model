        "decision_unit_id": "DU-001",
        "goal": "Complete Chapter 13.3 by adding a read-only V2 CI replay of current local-final mutation evidence, splitting local-final review facts from external CI execution facts in Gate, proving the closure in one isolated simulation, and projecting only 13.3 complete.",
        "impact_scope": [
          "src/aiflow/verification_service.py",
          "src/aiflow/gate.py",
          "tests/integration/test_verify_command.py",
          "tests/integration/test_gate_command.py",
