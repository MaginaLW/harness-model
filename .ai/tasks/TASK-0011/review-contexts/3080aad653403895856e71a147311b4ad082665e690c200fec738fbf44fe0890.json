        ],
        "planned_actions": [
          "Increment all four Policy documents from 2.0.0 to 2.1.0 for the semantic verification change",
          "Replace V2 acceptance and integration placeholder commands with deterministic offline pytest commands",
          "Execute acceptance and integration as distinct V2 checks with auditable process results and logs",
          "Preserve targeted mutation as explicitly unverified until Chapter 11.2 through 11.5",
          "Clarify Chapter 9 Policy 2.0.0 as a historical baseline rather than the current active version",
          "Update focused tests and Chapter 11 progress documentation"
        ]
      }
